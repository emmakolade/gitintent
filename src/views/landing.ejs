<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title %></title>
    <link rel="stylesheet" href="/styles.css" />
  </head>
  <body>
    <main class="layout">
      <section class="card hero">
        <p class="eyebrow">GitIntent</p>
        <h1>Get notified when someone checks your GitHub.</h1>
        <p class="content">
          Connect your GitHub, share your tracked link anywhere, and get instant email alerts with
          source, location, and time whenever someone visits.
        </p>
        <a class="btn" href="/auth/github">Continue with GitHub</a>
      </section>
    </main>
  </body>
</html>
