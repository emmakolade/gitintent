{
  "name": "gitintent2.0",
  "version": "1.0.0",
  "description": "GitIntent with GitHub OAuth, MongoDB tracking, and email alerts",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "copy:assets": "node -e \"const fs=require('fs');fs.mkdirSync('dist/public',{recursive:true});fs.cpSync('src/public','dist/public',{recursive:true});fs.cpSync('src/views','dist/public/views',{recursive:true});\"",
    "build": "tsc -p tsconfig.json && npm run copy:assets",
    "start": "node dist/server.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "connect-mongo": "^6.0.0",
    "dotenv": "^17.4.2",
    "ejs": "^6.0.1",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "mongoose": "^9.9.2",
    "nodemailer": "^9.0.5",
    "passport": "^0.7.0",
    "passport-github2": "^0.1.12"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/node": "^26.2.0",
    "@types/nodemailer": "^8.0.1",
    "@types/passport": "^1.0.17",
    "@types/passport-github2": "^1.2.9",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.6.3"
  }
}
